---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';
interface Props {
  etiqueta: string;
  titulo: string;
  destaque?: string;
  subtitulo: string;
  itens?: string[];
  mensagem?: string;
  grande?: boolean;
}
const {
  etiqueta, titulo, destaque, subtitulo, mensagem, grande,
  itens = ['Atendimento no mesmo dia', 'Todas as marcas', 'Garantia no serviço'],
} = Astro.props;
---
{grande ? (
  <section class="hero hero--home">
    <img
      class="hero__fundo"
      src="/img/hero-falcon-1200.webp"
      srcset="/img/hero-falcon-640.webp 640w, /img/hero-falcon-1200.webp 960w"
      sizes="(max-width: 960px) 100vw, 60vw"
      width="960" height="720" alt="Técnico da Falcon Aquecedores fazendo manutenção em aquecedor a gás Rinnai"
      fetchpriority="high" decoding="async"
    />
    <div class="container hero__in">
      <div class="hero__txt">
        <span class="hero__eyebrow">{etiqueta}</span>
        <h1>{titulo}{destaque && <> <span class="txt-laranja">{destaque}</span></>}</h1>
        <p class="hero__sub" set:html={subtitulo} />
        <ul class="hero__lista">
          {itens.map((i) => <li><Icon name="selo" size={20} /> {i}</li>)}
        </ul>
        <div class="hero__btns">
          <a class="btn-duplo btn-duplo--wpp" href={whatsappUrl(mensagem)} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={34} />
            <span><strong>Solicitar orçamento</strong><small>Fale agora pelo WhatsApp</small></span>
          </a>
          <a class="btn-duplo btn-duplo--ligar" href={`tel:${site.telefoneLink}`}>
            <Icon name="telefone" size={30} />
            <span><strong>Ligar agora</strong><small>{site.telefoneBotao}</small></span>
          </a>
        </div>
      </div>
    </div>
  </section>
) : (
<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__in">
    <div class="hero__txt">
      <span class="eyebrow"><Icon name="chama" size={16} /> {etiqueta}</span>
      <h1>{titulo}{destaque && <> <span class="txt-laranja">{destaque}</span></>}</h1>
      <p class="hero__sub">{subtitulo}</p>
      <div class="hero__btns">
        <a class="btn btn--wpp btn--lg" href={whatsappUrl(mensagem)} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /> Orçamento pelo WhatsApp</a>
        <a class="btn btn--ligar btn--lg" href={`tel:${site.telefoneLink}`}><Icon name="telefone" size={20} /> {site.telefoneBotao}</a>
      </div>
      <ul class="hero__itens">
        {itens.map((i) => <li><Icon name="check" size={18} /> {i}</li>)}
      </ul>
    </div>
    <div class="hero__mini" aria-hidden="true">
      <img src="/img/logo-falcon-480.webp" width="405" height="422" alt="" fetchpriority="high" />
    </div>
  </div>
</section>
)}
