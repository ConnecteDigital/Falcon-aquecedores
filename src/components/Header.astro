---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';
import { servicos } from '../data/servicos';
import { zonas, urlZona, urlBairro, URL_RIO } from '../data/zonas';
---
<header class="header" id="topo">
  <div class="container header__in">
    <a href="/" class="logo" aria-label={`${site.nome} - página inicial`}>
      <img src="/img/logo-falcon-160.webp" width="56" height="58" alt={`Logo ${site.nome}`} />
      <span class="logo__txt"><strong>FALCON</strong><small>AQUECEDORES</small></span>
    </a>
    <a class="header__wpp" href={whatsappUrl()} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={18} /> Orçamento
    </a>
    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu"><Icon name="menu" size={28} /></button>
    <nav id="menu" class="nav" aria-label="Menu principal">
      <ul>
        <li><a href="/">Início</a></li>
        <li class="has-sub">
          <a href="/servicos/">Serviços</a>
          <ul class="sub">
            {servicos.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}
          </ul>
        </li>
        <li class="has-sub has-mega">
          <a href="/#areas">Áreas Atendidas</a>
          <div class="mega">
            <a class="mega__topo" href={URL_RIO}>Rio de Janeiro — todas as zonas e bairros <Icon name="seta" size={16} /></a>
            <div class="mega__corpo">
              <ul class="mega__zonas">
                {zonas.map((z, i) => (
                  <li><a class:list={['mega__zona', { 'is-ativo': i === 0 }]} href={urlZona(z)} data-zona={z.slug}>{z.nome} <span aria-hidden="true">›</span></a></li>
                ))}
              </ul>
              <div class="mega__paineis">
                {zonas.map((z, i) => (
                  <div class:list={['mega__painel', { 'is-ativo': i === 0 }]} data-zona={z.slug}>
                    <a class="mega__ver" href={urlZona(z)}>Ver página: {z.nome} <span aria-hidden="true">›</span></a>
                    <ul class="mega__bairros">
                      {z.bairros.map((b) => <li><a href={urlBairro(b)}><Icon name="pin" size={15} /> {b.nome}</a></li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </li>
        <li><a href="/sobre/">Sobre</a></li>
        <li><a href="/contato/">Contato</a></li>
      </ul>
      <a class="btn btn--primary btn--sm" href={whatsappUrl()} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> Orçamento
      </a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector('.nav-toggle');
  const nav = document.getElementById('menu');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  // Menu de áreas: ao passar o mouse numa zona, mostra os bairros dela
  const ativar = (slug: string) => {
    document.querySelectorAll<HTMLElement>('.mega__zona, .mega__painel').forEach((el) => {
      el.classList.toggle('is-ativo', el.dataset.zona === slug);
    });
  };
  document.querySelectorAll<HTMLElement>('.mega__zona').forEach((el) => {
    const go = () => ativar(el.dataset.zona!);
    el.addEventListener('mouseenter', go);
    el.addEventListener('focus', go);
  });
</script>
