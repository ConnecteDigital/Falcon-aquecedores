---
import Icon from './Icon.astro';
import { zonas as todasZonas, urlZona, urlBairro, type Zona } from '../data/zonas';
import { site } from '../data/site';
interface Props { completo?: boolean; titulo?: string; zonas?: Zona[]; texto?: string }
const {
  completo = false, titulo = `Áreas atendidas no Rio de Janeiro e região`, zonas = todasZonas,
  texto = 'Técnicos espalhados pela região para chegar rápido até você. Encontre a sua região e o seu bairro.',
} = Astro.props;
const LIMITE = 12;
---
<section class="secao secao--clara" id="areas">
  <div class="container">
    <header class="secao__head">
      <span class="eyebrow eyebrow--escuro">Onde atendemos</span>
      <h2>{titulo}</h2>
      <p>{texto}</p>
    </header>
    <div class="zonas">
      {zonas.map((z) => (
        <div class="zona">
          <h3><a href={urlZona(z)}><Icon name="pin" size={20} /> {z.nome}</a></h3>
          <ul class="zona__bairros">
            {(completo ? z.bairros : z.bairros.slice(0, LIMITE)).map((b) => (
              <li><a href={urlBairro(b)}>{b.nome}</a></li>
            ))}
          </ul>
          <a class="zona__mais" href={urlZona(z)}>
            {completo ? `Aquecedor a gás ${z.na}` : `Ver todos os ${z.bairros.length} bairros`} <Icon name="seta" size={16} />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
