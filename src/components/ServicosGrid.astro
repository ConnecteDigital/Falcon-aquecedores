---
import Icon from './Icon.astro';
import { servicos } from '../data/servicos';
import { whatsappUrl } from '../data/site';
interface Props { titulo?: string; subtitulo?: string; local?: string; excluir?: string }
const { titulo = 'Nossos Serviços', subtitulo, local, excluir } = Astro.props;
const lista = servicos.filter((s) => s.slug !== excluir);
---
<section class="secao secao--clara" id="servicos">
  <div class="container">
    <header class="secao__head">
      <span class="eyebrow eyebrow--escuro">O que fazemos</span>
      <h2>{titulo}</h2>
      {subtitulo && <p>{subtitulo}</p>}
    </header>
    <div class="cards">
      {lista.map((s) => (
        <article class="card-servico">
          <a class:list={['card-servico__foto', { 'is-produto': !s.foto.retrato }]} href={`/servicos/${s.slug}/`} tabindex="-1" aria-hidden="true">
            <img src={`${s.foto.src}-480.webp`} alt={s.foto.alt} width="480" height="360" loading="lazy" decoding="async" />
          </a>
          <span class="card-servico__icone"><Icon name={s.icone} size={30} /></span>
          <h3><a href={`/servicos/${s.slug}/`}>{s.nome}{local && <span class="sr-only"> {local}</span>}</a></h3>
          <p>{s.resumo}</p>
          <div class="card-servico__acoes">
            <a class="btn btn--wpp btn--sm" href={whatsappUrl(`Olá! Vim pelo site e preciso de ${s.nome.toLowerCase()}.`)} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={18} /> WhatsApp
            </a>
            <a class="card-servico__link" href={`/servicos/${s.slug}/`}>Saiba mais <Icon name="seta" size={16} /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
