---
import type { Crumb } from '../layouts/Base.astro';
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Você está em">
  <ol class="container">
    <li><a href="/">Início</a></li>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.nome}</span> : <a href={c.url}>{c.nome}</a>}</li>
    ))}
  </ol>
</nav>
