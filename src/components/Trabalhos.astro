---
// Carrossel de serviços realizados.
// Para adicionar fotos (.jpg, .jpeg, .png, .webp) ou vídeos curtos (.mp4), basta
// colocar os arquivos na pasta src/assets/trabalhos/. O nome do arquivo vira a
// descrição (ex.: "instalacao-aquecedor-rinnai-copacabana.jpg" →
// "Instalação aquecedor Rinnai copacabana"), então use nomes descritivos.
// Os itens seguem a ordem alfabética; um número no início ("01-", "03a-")
// define a posição e não aparece na legenda. Legendas longas ficam em
// src/data/legendas.ts. Para um vídeo, dá para colocar
// uma imagem de capa em capas/ com o mesmo nome (ex.: capas/meu-video.jpg).
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';
import { legendas } from '../data/legendas';

interface Props { titulo?: string }
const { titulo = 'Serviços realizados' } = Astro.props;

const arquivos = import.meta.glob<{ default: ImageMetadata }>('../assets/trabalhos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const videos = import.meta.glob<string>('../assets/trabalhos/*.{mp4,MP4,webm}', { eager: true, query: '?url', import: 'default' });
// Capa opcional de cada vídeo: capas/<mesmo nome do vídeo>.jpg
const capas = import.meta.glob<{ default: ImageMetadata }>('../assets/trabalhos/capas/*.{jpg,jpeg,png,webp}', { eager: true });
const capaDe = async (video: string) => {
  const base = video.split('/').pop()!.replace(/\.[^.]+$/, '');
  const achada = Object.entries(capas).find(([c]) => c.split('/').pop()!.replace(/\.[^.]+$/, '') === base);
  return achada ? (await getImage({ src: achada[1].default, width: 600, quality: 70 })).src : undefined;
};

const PALAVRAS: Record<string, string> = {
  instalacao: 'instalação', manutencao: 'manutenção', conversao: 'conversão', chamine: 'chaminé',
  eletronica: 'eletrônica', agua: 'água', gas: 'gás', area: 'área', servico: 'serviço',
  flexivel: 'flexível', exaustao: 'exaustão', acumulacao: 'acumulação', condominio: 'condomínio',
  maquinas: 'máquinas', readequacao: 'readequação', adequacao: 'adequação', reservatorio: 'reservatório', termico: 'térmico', analogico: 'analógico',
  glp: 'GLP', gn: 'GN', rinnai: 'Rinnai', lorenzetti: 'Lorenzetti', komeco: 'Komeco', kobe: 'Kobe',
  bosch: 'Bosch', cumulus: 'Cumulus', orbis: 'Orbis', sakura: 'Sakura', inova: 'Inova',
};
const descrever = (caminho: string) => {
  const arquivo = caminho.split('/').pop()!.replace(/\.[^.]+$/, '');
  if (legendas[arquivo]) return legendas[arquivo];
  const nome = arquivo.replace(/^\d+[a-z]?[-_ ]+/i, '');
  const txt = nome.split(/[-_ ]+/).filter(Boolean).map((p) => PALAVRAS[p.toLowerCase()] ?? p).join(' ');
  return txt.charAt(0).toUpperCase() + txt.slice(1);
};

type Item = { chave: string; legenda: string; img?: ImageMetadata; video?: string; capa?: string };
const fotos: Item[] = [
  ...Object.entries(arquivos).map(([c, mod]) => ({ chave: c, legenda: descrever(c), img: mod.default })),
  ...(await Promise.all(Object.entries(videos).map(async ([c, url]) => ({ chave: c, legenda: descrever(c), video: url, capa: await capaDe(c) })))),
].sort((a, b) => a.chave.localeCompare(b.chave));
---
{fotos.length > 0 && (
  <section class="secao secao--escura" id="trabalhos">
    <div class="container">
      <header class="secao__head">
        <span class="eyebrow">Nosso trabalho</span>
        <h2>{titulo}</h2>
        <p>Alguns dos aquecedores que instalamos, consertamos e mantemos no Rio de Janeiro e região.</p>
      </header>
      <div class="carrossel" data-carrossel>
        <button class="carrossel__btn carrossel__btn--ant" type="button" aria-label="Foto anterior" data-ant>
          <Icon name="seta" size={22} />
        </button>
        <ul class="carrossel__trilho" data-trilho>
          {fotos.map((f) => (
            <li class="carrossel__item">
              <figure>
                {f.img ? (
                  <Image src={f.img} alt={`${f.legenda} - Falcon Aquecedores`} width={600} quality={72} loading="lazy" decoding="async" />
                ) : (
                  <video src={`${f.video}#t=0.5`} poster={f.capa} controls playsinline muted preload={f.capa ? 'none' : 'metadata'} aria-label={f.legenda}></video>
                )}
                <figcaption>{f.video && <span class="carrossel__tag">Vídeo</span>}{f.legenda}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <button class="carrossel__btn carrossel__btn--prox" type="button" aria-label="Próxima foto" data-prox>
          <Icon name="seta" size={22} />
        </button>
      </div>
      <div class="carrossel__cta">
        <a class="btn btn--wpp" href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Quero um orçamento</a>
      </div>
    </div>
  </section>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-carrossel]').forEach((c) => {
    const trilho = c.querySelector<HTMLElement>('[data-trilho]')!;
    const passo = () => (trilho.querySelector<HTMLElement>('.carrossel__item')?.offsetWidth ?? 300) + 18;
    const fim = () => trilho.scrollLeft + trilho.clientWidth >= trilho.scrollWidth - 5;
    const proximo = () => trilho.scrollBy({ left: fim() ? -trilho.scrollWidth : passo(), behavior: 'smooth' });
    c.querySelector('[data-prox]')?.addEventListener('click', proximo);
    c.querySelector('[data-ant]')?.addEventListener('click', () => trilho.scrollBy({ left: -passo(), behavior: 'smooth' }));
    // Avança sozinho, pausando quando o visitante interage
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let pausado = false;
    ['mouseenter', 'touchstart', 'focusin'].forEach((e) => c.addEventListener(e, () => (pausado = true), { passive: true }));
    c.addEventListener('mouseleave', () => (pausado = [...c.querySelectorAll('video')].some((v) => !v.paused)));
    c.querySelectorAll('video').forEach((v) => {
      v.addEventListener('play', () => (pausado = true));
      v.addEventListener('ended', () => (pausado = false));
    });
    setInterval(() => { if (!pausado && !document.hidden) proximo(); }, 4000);
  });
</script>
