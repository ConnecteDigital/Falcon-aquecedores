---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ServicosGrid from '../../components/ServicosGrid.astro';
import Diferenciais from '../../components/Diferenciais.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { servicos } from '../../data/servicos';
import { site } from '../../data/site';
---
<Base
  title="Serviços para Aquecedor a Gás em São Paulo"
  description="Conserto, manutenção, instalação, limpeza, conversão de gás e troca de peças de aquecedor a gás em São Paulo. Conheça todos os serviços da Falcon Aquecedores."
  breadcrumbs={[{ nome: 'Serviços', url: '/servicos/' }]}
  schema={[{
    '@context': 'https://schema.org', '@type': 'ItemList',
    itemListElement: servicos.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.nome, url: `${site.url}/servicos/${s.slug}/` })),
  }]}
>
  <Hero
    etiqueta="Serviços"
    titulo="Serviços para Aquecedor a Gás"
    destaque="em São Paulo"
    subtitulo="Do conserto à instalação: tudo o que o seu aquecedor a gás precisa, feito por técnicos especializados e com garantia."
  />
  <ServicosGrid titulo="Escolha o serviço" />
  <Diferenciais />
  <CtaFinal />
</Base>
