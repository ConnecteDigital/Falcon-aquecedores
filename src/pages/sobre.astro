---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Numeros from '../components/Numeros.astro';
import Trabalhos from '../components/Trabalhos.astro';
import Sobre from '../components/Sobre.astro';
import Diferenciais from '../components/Diferenciais.astro';
import Depoimentos from '../components/Depoimentos.astro';
import CtaFinal from '../components/CtaFinal.astro';
---
<Base
  title="Sobre a Falcon Aquecedores"
  description="Conheça a Falcon Aquecedores, especialista em conserto, manutenção e instalação de aquecedor a gás no Rio de Janeiro. Técnicos especializados e garantia."
  breadcrumbs={[{ nome: 'Sobre', url: '/sobre/' }]}
>
  <Hero etiqueta="Quem somos" titulo="Sobre a" destaque="Falcon Aquecedores" subtitulo="Agilidade, precisão e segurança no cuidado com o seu aquecedor a gás." />
  <Numeros />
  <Sobre />
  <Trabalhos />
  <Diferenciais />
  <Depoimentos />
  <CtaFinal />
</Base>
