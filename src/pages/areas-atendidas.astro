---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Areas from '../components/Areas.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { zonas, todosBairros, urlZona } from '../data/zonas';
import { site } from '../data/site';
---
<Base
  title="Áreas Atendidas: Conserto de Aquecedor a Gás no RJ"
  description={`A Falcon Aquecedores atende ${todosBairros.length} bairros no Rio de Janeiro, Niterói, São Gonçalo e Baixada Fluminense. Encontre seu bairro e chame um técnico.`}
  breadcrumbs={[{ nome: 'Áreas Atendidas', url: '/areas-atendidas/' }]}
  schema={[{
    '@context': 'https://schema.org', '@type': 'ItemList',
    itemListElement: zonas.map((z, i) => ({ '@type': 'ListItem', position: i + 1, name: z.nome, url: `${site.url}${urlZona(z)}` })),
  }]}
>
  <Hero
    etiqueta="Áreas atendidas"
    titulo="Conserto de Aquecedor a Gás em"
    destaque="todo o Rio e região"
    subtitulo={`Atendemos ${todosBairros.length} bairros em ${zonas.length} regiões. Encontre a sua região e o seu bairro abaixo.`}
  />
  <Areas completo titulo="Zonas e bairros atendidos" />
  <CtaFinal />
</Base>
