---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Numeros from '../components/Numeros.astro';
import ServicosGrid from '../components/ServicosGrid.astro';
import Sobre from '../components/Sobre.astro';
import Diferenciais from '../components/Diferenciais.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Marcas from '../components/Marcas.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Areas from '../components/Areas.astro';
import Faq from '../components/Faq.astro';
import ContatoForm from '../components/ContatoForm.astro';
import { site } from '../data/site';
import { faqGeral, faqSchema } from '../lib/conteudo';
---
<Base
  title={`Conserto de Aquecedor a Gás no Rio de Janeiro | ${site.nome}`}
  noTitleSuffix
  description="Conserto de aquecedor a gás no Rio de Janeiro, Niterói, São Gonçalo e Baixada com técnicos especializados. Manutenção, instalação e limpeza de todas as marcas. Atendimento rápido e garantia."
  schema={[
    { '@context': 'https://schema.org', '@type': 'WebSite', name: site.nome, url: site.url, inLanguage: 'pt-BR' },
    faqSchema(faqGeral),
  ]}
>
  <Hero
    grande
    etiqueta="Conforto e segurança para sua família"
    titulo="Instalação, venda e manutenção de aquecedores a gás"
    subtitulo='Atendimento especializado em todo o <span class="txt-destaque">Rio de Janeiro</span> com qualidade e garantia.'
    itens={['Técnicos especializados', 'Serviço rápido e seguro', 'Peças originais e garantia', 'Parcelamento facilitado']}
  />
  <Numeros />
  <ServicosGrid subtitulo="Soluções completas para aquecedores a gás de passagem e de acumulação, residenciais e comerciais." />
  <Sobre />
  <Diferenciais />
  <ComoFunciona />
  <Marcas />
  <Depoimentos />
  <Areas completo />
  <Faq itens={faqGeral} />
  <ContatoForm />
</Base>
